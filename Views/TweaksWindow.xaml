<Window x:Class="CoreIsolator.Views.TweaksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Otimizações do Sistema"
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BaseBrush}"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource BaseBrush}" 
            BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de Título Customizada -->
            <Border Grid.Row="0" Background="{StaticResource CrustBrush}" CornerRadius="12,12,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Text="🛠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Otimizações All-in-One" 
                                   Foreground="{StaticResource TextBrush}" 
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="14" FontWeight="SemiBold" 
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <Button x:Name="CloseButton" Content="✕" Click="CloseButton_Click" 
                                Width="36" Height="28" FontSize="12"
                                Foreground="{StaticResource SubtextBrush}" 
                                Background="Transparent" BorderThickness="0" Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Conteúdo -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Módulo de Limpeza e Tweaks" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                    <TextBlock Text="Executa scripts avançados de otimização no Windows (registro, telemetria nativa, cache)." Foreground="{StaticResource SubtextBrush}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Console Output -->
                <Border Grid.Row="1" Background="{StaticResource MantleBrush}" CornerRadius="8" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1" Padding="12">
                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource GreenAccentBrush}" FontFamily="Consolas" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <!-- Botões de Ação -->
                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- O RelayCommand do MVVM Toolkit desativa o OptimizeCommand automaticamente enquanto roda. -->
                        <Button Content="🛑 Cancelar" Command="{Binding OptimizeCancelCommand}" 
                                Visibility="{Binding IsOptimizing, Converter={StaticResource BoolToVis}}"
                                Width="120" Height="38" Margin="0,0,12,0" 
                                Background="{StaticResource CrustBrush}" Foreground="{StaticResource RedAccentBrush}" 
                                BorderBrush="{StaticResource RedAccentBrush}" BorderThickness="1"
                                FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="🚀 Iniciar Otimização" Command="{Binding OptimizeCommand}" 
                                Width="180" Height="38" 
                                Background="{StaticResource BlueAccentBrush}" Foreground="{StaticResource CrustBrush}" 
                                FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                    
                    <!-- Indicador de Carregamento -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Visibility="{Binding IsOptimizing, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Executando otimizações..." Foreground="{StaticResource BlueAccentBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
