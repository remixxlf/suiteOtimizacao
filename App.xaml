<Application x:Class="CoreIsolator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- System Tray Icon -->
            <ContextMenu x:Key="TrayContextMenu">
                <ContextMenu.Style>
                    <Style TargetType="ContextMenu">
                        <Setter Property="Background" Value="#1E1E2E" />
                        <Setter Property="Foreground" Value="#CDD6F4" />
                        <Setter Property="BorderBrush" Value="#45475A" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="4" />
                    </Style>
                </ContextMenu.Style>
                <MenuItem Header="🖥️ Mostrar CoreIsolator" Click="ShowWindow_Click" FontWeight="SemiBold" />
                <Separator />
                <MenuItem Header="❌ Sair" Click="ExitApp_Click" />
            </ContextMenu>

            <!-- 
                Modificação (DIDÁTICA): Configuração do System Tray (TaskbarIcon)
                1. IconSource: Define a imagem que aparecerá ao lado do relógio. Se isso não for definido, 
                   o componente existe na memória, mas não tem rosto, logo, "some". 
                   Usamos um caminho Pack URI para pegar o ícone de dentro do executável.
                   *(Nota: Certifique-se de ter um arquivo 'icon.ico' na pasta Resources).*
                2. Visibility: Garante explicitamente que o ícone está visível.
            -->
            <tb:TaskbarIcon x:Key="TrayIcon"
                            IconSource="pack://application:,,,/Resources/icon.ico"
                            Visibility="Visible"
                            ToolTipText="CoreIsolator — Isolador de Núcleos"
                            ContextMenu="{StaticResource TrayContextMenu}"
                            TrayLeftMouseDown="TrayIcon_TrayLeftMouseDown" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
