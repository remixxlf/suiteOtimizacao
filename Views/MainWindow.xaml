<Window x:Class="CoreIsolator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        mc:Ignorable="d"
        Title="CoreIsolator — Isolador de Núcleos"
        Height="720" Width="980"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BaseBrush}"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Converter para visibilidade booleana -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource BaseBrush}" 
            BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />   <!-- Barra de título customizada -->
                <RowDefinition Height="*" />    <!-- Conteúdo principal -->
                <RowDefinition Height="32" />   <!-- Barra de status -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════ -->
            <!--           BARRA DE TÍTULO CUSTOM           -->
            <!-- ══════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{StaticResource CrustBrush}" CornerRadius="12,12,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Text="⚡" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="CoreIsolator" 
                                   Foreground="{StaticResource TextBrush}" 
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="14" FontWeight="SemiBold" 
                                   VerticalAlignment="Center" />
                        <TextBlock Text="v1.0" 
                                   Foreground="{StaticResource OverlayBrush}" 
                                   FontSize="11" Margin="8,2,0,0" 
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Botões da janela -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <!-- Novo Botão de Otimização -->
                        <Button x:Name="TweaksButton" Content="🛠️ Otimizar PC" 
                                Click="TweaksButton_Click"
                                Height="28" Padding="12,0" Margin="0,0,12,0" FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource CrustBrush}"
                                Background="{StaticResource BlueAccentBrush}" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        
                        <Button x:Name="MinimizeButton" Content="—" 
                                Click="MinimizeButton_Click"
                                Width="36" Height="28" FontSize="13"
                                Foreground="{StaticResource SubtextBrush}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{StaticResource Surface0Brush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="CloseButton" Content="✕" 
                                Click="CloseButton_Click"
                                Width="36" Height="28" FontSize="12"
                                Foreground="{StaticResource SubtextBrush}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{StaticResource RedAccentBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource CrustBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════ -->
            <!--             CONTEÚDO PRINCIPAL             -->
            <!-- ══════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="20,16,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />      <!-- Coluna esquerda -->
                    <ColumnDefinition Width="16" />     <!-- Espaçamento -->
                    <ColumnDefinition Width="340" />    <!-- Coluna direita (Perfis + Log) -->
                </Grid.ColumnDefinitions>

                <!-- ─── COLUNA ESQUERDA ─── -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Card: Status do Sistema -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="🖥️ Status do Sistema" />
                                        <TextBlock x:Name="CpuNameText" 
                                                   Style="{StaticResource SubtitleText}" 
                                                   Text="Detectando CPU..." />
                                    </StackPanel>
                                    <!-- Badge de status -->
                                    <Border x:Name="StatusBadge" 
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Style="{StaticResource StatusBadge}"
                                            Background="{StaticResource Surface1Brush}">
                                        <TextBlock x:Name="StatusBadgeText" 
                                                   Text="⏸ Idle" 
                                                   Foreground="{StaticResource SubtextBrush}" 
                                                   FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <!-- Contagem de cores -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- P-Cores -->
                                    <Border Grid.Column="0" Background="{StaticResource MantleBrush}" 
                                            CornerRadius="8" Padding="12,10" Margin="0,0,6,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="P-Cores" Foreground="{StaticResource BlueAccentBrush}" 
                                                       FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="PCoreCountText" Text="—" 
                                                       Foreground="{StaticResource TextBrush}" 
                                                       FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" 
                                                       FontFamily="Segoe UI Variable Display" />
                                        </StackPanel>
                                    </Border>

                                    <!-- E-Cores -->
                                    <Border Grid.Column="1" Background="{StaticResource MantleBrush}" 
                                            CornerRadius="8" Padding="12,10" Margin="3,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="E-Cores" Foreground="{StaticResource GreenAccentBrush}" 
                                                       FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="ECoreCountText" Text="—" 
                                                       Foreground="{StaticResource TextBrush}" 
                                                       FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" 
                                                       FontFamily="Segoe UI Variable Display" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Threads -->
                                    <Border Grid.Column="2" Background="{StaticResource MantleBrush}" 
                                            CornerRadius="8" Padding="12,10" Margin="6,0,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="Threads" Foreground="{StaticResource MauveAccentBrush}" 
                                                       FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="ThreadCountText" Text="—" 
                                                       Foreground="{StaticResource TextBrush}" 
                                                       FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" 
                                                       FontFamily="Segoe UI Variable Display" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card: Topologia dos Núcleos -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="🧮 Topologia dos Núcleos" />
                                <TextBlock Style="{StaticResource SubtitleText}" 
                                           Text="Visualização da distribuição de núcleos do processador" />

                                <!-- Grid visual dos núcleos (gerado dinamicamente no code-behind) -->
                                <WrapPanel x:Name="CoreVisualizationPanel" 
                                           Margin="0,12,0,0"
                                           HorizontalAlignment="Left" />

                                <!-- Legenda -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Border Background="{StaticResource PCoreBadgeGradient}" 
                                            CornerRadius="4" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="P-Core" Foreground="{StaticResource SubtextBrush}" 
                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Border Background="{StaticResource ECoreBadgeGradient}" 
                                            CornerRadius="4" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="E-Core" Foreground="{StaticResource SubtextBrush}" 
                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Border Background="{StaticResource Surface2Brush}" 
                                            CornerRadius="4" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="HT Thread" Foreground="{StaticResource SubtextBrush}" 
                                               FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card: Jogo Ativo (visível apenas quando um jogo está isolado) -->
                        <Border x:Name="ActiveGameCard" Style="{StaticResource CardPanel}" Visibility="Collapsed"
                                BorderBrush="{StaticResource GreenAccentBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="🎮 Jogo Ativo" />
                                        <TextBlock x:Name="ActiveGameNameText" 
                                                   Foreground="{StaticResource GreenAccentBrush}" 
                                                   FontSize="18" FontWeight="Bold" 
                                                   FontFamily="Segoe UI Variable Display" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Style="{StaticResource StatusBadge}"
                                            Background="#2EA6E3A1">
                                        <TextBlock Text="🟢 Isolado" 
                                                   Foreground="{StaticResource GreenAccentBrush}" 
                                                   FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Máscara de Afinidade" 
                                                   Foreground="{StaticResource SubtextBrush}" FontSize="11" />
                                        <TextBlock x:Name="ActiveAffinityText" Text="0x00FF" 
                                                   Foreground="{StaticResource TextBrush}" FontSize="14" 
                                                   FontFamily="Cascadia Code, Consolas" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Prioridade" 
                                                   Foreground="{StaticResource SubtextBrush}" FontSize="11" />
                                        <TextBlock x:Name="ActivePriorityText" Text="HIGH" 
                                                   Foreground="{StaticResource PeachAccentBrush}" FontSize="14" 
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card: Configurações -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="⚙️ Configurações" />
                                <CheckBox x:Name="AutoStartCheckBox" 
                                          Style="{StaticResource DarkCheckBox}" 
                                          Content="Iniciar com o Windows (via Agendador de Tarefas)"
                                          Margin="0,4" 
                                          Checked="AutoStartCheckBox_Changed" 
                                          Unchecked="AutoStartCheckBox_Changed" />
                                <CheckBox x:Name="RestoreAffinityCheckBox" 
                                          Style="{StaticResource DarkCheckBox}" 
                                          Content="Restaurar afinidade ao fechar o jogo" 
                                          IsChecked="True" Margin="0,4"
                                          Checked="RestoreAffinityCheckBox_Changed"
                                          Unchecked="RestoreAffinityCheckBox_Changed" />
                                <CheckBox x:Name="ShowNotificationsCheckBox" 
                                          Style="{StaticResource DarkCheckBox}" 
                                          Content="Exibir notificações na bandeja" 
                                          IsChecked="True" Margin="0,4"
                                          Checked="ShowNotificationsCheckBox_Changed"
                                          Unchecked="ShowNotificationsCheckBox_Changed" />
                                <CheckBox x:Name="MinimizeOnStartCheckBox" 
                                          Style="{StaticResource DarkCheckBox}" 
                                          Content="Iniciar minimizado na bandeja" 
                                          IsChecked="True" Margin="0,4"
                                          Checked="MinimizeOnStartCheckBox_Changed"
                                          Unchecked="MinimizeOnStartCheckBox_Changed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ─── COLUNA DIREITA ─── -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />     <!-- Perfis de Jogos -->
                        <RowDefinition Height="12" />    <!-- Espaçamento -->
                        <RowDefinition Height="220" />   <!-- Log de Atividade -->
                    </Grid.RowDefinitions>

                    <!-- Card: Perfis de Jogos -->
                    <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="🎯 Perfis de Jogos" />
                                <TextBlock Style="{StaticResource SubtitleText}" 
                                           Text="Executáveis monitorados para isolamento automático" />
                            </StackPanel>

                            <!-- Lista de Perfis -->
                            <ListBox x:Name="ProfileListBox" Grid.Row="1" 
                                     Style="{StaticResource DarkListBox}" 
                                     Margin="0,8,0,8"
                                     ItemContainerStyle="{StaticResource DarkListBoxItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding GameName}" 
                                                           Foreground="{StaticResource TextBrush}" 
                                                           FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding ExecutableName}" 
                                                           Foreground="{StaticResource OverlayBrush}" 
                                                           FontSize="11" FontFamily="Cascadia Code, Consolas" />
                                            </StackPanel>
                                            <Border Grid.Column="1" VerticalAlignment="Center"
                                                    CornerRadius="8" Padding="8,3"
                                                    Background="{StaticResource Surface1Brush}">
                                                <TextBlock Text="{Binding Priority}" 
                                                           Foreground="{StaticResource PeachAccentBrush}" 
                                                           FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Botões de ação -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Adicionar perfil -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                    <TextBox x:Name="NewGameNameBox" 
                                             Style="{StaticResource DarkTextBox}" 
                                             Width="100" Margin="0,0,4,0"
                                             Tag="Nome do jogo" />
                                    <TextBox x:Name="NewGameExeBox" 
                                             Style="{StaticResource DarkTextBox}" 
                                             Width="110" Margin="0,0,4,0"
                                             Tag="exe (ex: cs2.exe)" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="＋ Adicionar" 
                                        Style="{StaticResource PrimaryButton}" 
                                        Click="AddProfile_Click"
                                        Padding="12,6" FontSize="12" />
                                <Button Grid.Column="2" Content="🗑" 
                                        Style="{StaticResource DangerButton}" 
                                        Click="RemoveProfile_Click"
                                        HorizontalAlignment="Right"
                                        Padding="8,6" FontSize="12" Width="36" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Card: Log de Atividade -->
                    <Border Grid.Row="2" Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="📋 Log de Atividade" />
                                <Button Content="Limpar" 
                                        Style="{StaticResource SecondaryButton}" 
                                        Click="ClearLog_Click"
                                        HorizontalAlignment="Right" 
                                        Padding="10,4" FontSize="11" />
                            </Grid>

                            <ListBox x:Name="LogListBox" Grid.Row="1" 
                                     Style="{StaticResource DarkListBox}"
                                     Margin="0,4,0,0"
                                     FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                                     FontSize="11"
                                     Foreground="{StaticResource SubtextBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ══════════════════════════════════════════ -->
            <!--             BARRA DE STATUS                -->
            <!-- ══════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="{StaticResource CrustBrush}" CornerRadius="0,0,12,12">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" 
                                 Fill="{StaticResource GreenAccentBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusBarText" 
                                   Text="Monitoramento ativo — aguardando jogo..." 
                                   Foreground="{StaticResource SubtextBrush}" 
                                   FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="MaskInfoText" 
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource OverlayBrush}" 
                               FontSize="11" FontFamily="Cascadia Code, Consolas" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
